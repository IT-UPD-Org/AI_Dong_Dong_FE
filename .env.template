# Copy to .env for local development. Vite inlines VITE_* values at build
# time, so in Docker pass them as --build-arg, not container env vars.

# BACKEND
# Leave empty to call /api on the same origin (Vite dev proxy or the upstream
# reverse proxy). Set only when the backend lives on a different origin.
VITE_API_BASE_URL=

# MICROSOFT LOGIN: nothing to set here. The frontend reads tenant, client and
# redirect URI from the backend (GET /api/auth/microsoft); configure MICROSOFT_*
# on the backend instead.

# SENTRY (error tracking; inactive when empty)
VITE_SENTRY_DSN=

# UMAMI ANALYTICS (production builds only; inactive unless both are set)
VITE_UMAMI_WEBSITE_ID=your_umami_website_id
VITE_UMAMI_SCRIPT_URL=https://u.itupd.io.vn/script.js
